<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.BioDeep.MSEngine.Mummichog</RootNamespace>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <Platforms>AnyCPU;ARM32;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;nuget_release</Configurations>
    <AssemblyName>BioNovoGene.BioDeep.MSEngine.Mummichog</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>Flask.png</PackageIcon>
    <PackageIconUrl />
    <Title>Mummichog Pathway Analysis</Title>
    <Description>Implementation of the Mummichog pathway-first, annotation-second (guilt-by-association) strategy for LC-MS untargeted metabolomics: maps peak m/z features onto theoretical metabolite and adduct m/z sets, groups correlated/adduct/isotope peaks and performs KEGG pathway enrichment with permutation-based p-values.</Description>
    <PackageTags>mzkit, mummichog, pathway-enrichment, untargeted-metabolomics, kegg, guilt-by-association, adduct, peak-annotation</PackageTags>
    <ReleaseNotes>Mummichog pathway analysis for mzkit: implements the pathway-first, annotation-second (guilt-by-association) strategy for LC-MS untargeted metabolomics; maps peak m/z features onto theoretical metabolite and adduct m/z sets; groups correlated, adduct and isotope peaks; and performs KEGG pathway enrichment with permutation-based p-values to pre-annotate metabolites without requiring full compound identification.</ReleaseNotes>
	  <OutputPath>../../../Rscript\Library\mzkit_app\assembly\</OutputPath>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
	  <UseApplicationFramework>True</UseApplicationFramework>
    <Version>1.0.9767.32135</Version>
    <AssemblyVersion>1.0.9767.32135</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net6.0|AnyCPU'">
    <DocumentationFile>BioNovoGene.BioDeep.MSEngine.Mummichog.xml</DocumentationFile>
    <RemoveIntegerChecks>true</RemoveIntegerChecks>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>false</DefineDebug>
  </PropertyGroup>

