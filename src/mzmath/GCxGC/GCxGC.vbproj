<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.Analytical.MassSpectrometry.GCxGC</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>BioNovoGene.Analytical.MassSpectrometry.GCxGC</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;mzkit;Rsharp_app_release;MEMI-Desktop;nuget_release</Configurations>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <Title>GCxGC 2D Chromatography Math</Title>
    <Description>Two-dimensional GCxGC (comprehensive two-dimensional gas chromatography) math library: demodulates modulated 1D GC-MS raw data into a 2D chromatogram mesh grid based on the modulation period, performs 2D peak detection on the mesh and handles 1D GC-MS EI peak models.</Description>
    <PackageTags>mzkit, gcxgc, gc-ms, two-dimensional-chromatography, demodulation, peak-detection, chromatogram</PackageTags>
    <ReleaseNotes>GCxGC math library for mzkit: demodulates modulated 1D GC-MS raw data into 2D chromatogram mesh grids using the modulation period; performs 2D peak detection over the demodulated chromatogram mesh; and provides 1D GC-MS EI peak models for comprehensive two-dimensional gas chromatography data processing.</ReleaseNotes>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>Flask.png</PackageIcon>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Version>1.0.9767.32135</Version>
    <AssemblyVersion>1.0.9767.32135</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../Rscript/Library/mzkit_app/assembly/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\.pkg\Flask.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\SignalProcessing\SignalProcessing\signalprocessing-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\ms2_math-core\mzmath-netcore5.vbproj" />
    <ProjectReference Include="..\mz_deco\deconv.NET5.vbproj" />
  </ItemGroup>

</Project>
