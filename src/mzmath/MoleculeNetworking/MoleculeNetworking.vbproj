<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.BioDeep.MassSpectrometry.MoleculeNetworking</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
	  <AssemblyName>BioNovoGene.BioDeep.MassSpectrometry.MoleculeNetworking</AssemblyName>
	  <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	  <Platforms>AnyCPU;ARM32;x64</Platforms>
	  <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;nuget_release</Configurations>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Title>Molecular Networking Generator</Title>
	  <Authors>xieguigang &lt;gg.xie@bionovogene.com&gt;</Authors>
	  <Company>PANOMIX</Company>
	  <UseApplicationFramework>True</UseApplicationFramework>
	  <Description>Molecular networking for untargeted MS/MS metabolomics: builds spectrum clustering trees via binary clustering and spectral similarity scoring, renders global molecular network graphs, manages persistent spectrum pools with DIA inference, consensus fragment evaluation and Word2Vec-style ion embedding of spectra.</Description>
	  <PackageTags>mzkit, molecular-networking, msms, spectral-clustering, spectrum-pool, dia, consensus-spectrum, embedding</PackageTags>
	  <ReleaseNotes>Molecular networking library for untargeted MS/MS metabolomics: builds spectrum clustering trees via binary clustering and spectral similarity scoring; renders global molecular network graphs; provides persistent spectrum pools over local, HTTP and REST file systems with metadata pools and DIA spectrum inference inside clusters; aligns samples to peak tables via spectrum grids with Pearson correlation; computes consensus fragments; and embeds spectra with Word2Vec-style ion embeddings.</ReleaseNotes>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <PackageIcon>Flask.png</PackageIcon>
	  <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Version>1.0.9767.32135</Version>
    <AssemblyVersion>1.0.9767.32135</AssemblyVersion>
  </PropertyGroup>

