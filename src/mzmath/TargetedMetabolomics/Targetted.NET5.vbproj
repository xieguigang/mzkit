<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.Analytical.MassSpectrometry.Math</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>BioNovoGene.Analytical.MassSpectrometry.Math.TargetedMetabolomics</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;PlantMAT;mzkit;Rsharp_app_release;MEMI-Desktop;nuget_release</Configurations>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>xieguigang</Authors>
    <Company>BioNovoGene</Company>
    <Product>BioDeep</Product>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>http://mzkit.org</PackageProjectUrl>
    <PackageIcon>Flask.png</PackageIcon>
    <PackageIconUrl />
    <Title>Targeted Metabolomics Quantification</Title>
    <Description>Targeted metabolomics quantification framework covering three workflows: linear standard-curve quantification with internal/external standards, MRM ion-pair quantification with RT alignment and isomer handling, and GC-MS scan/SIM ion extraction with vendor raw readers; also includes pharmacokinetics (PK) analysis and TPA content reporting.</Description>
    <PackageTags>mzkit, targeted-metabolomics, mrm, standard-curve, quantification, internal-standard, gcms, pharmacokinetics</PackageTags>
    <ReleaseNotes>Targeted metabolomics quantification framework for mzkit: linear standard-curve quantification with external and internal standards, peak-area integration, ion TPA computation and CDF persistence; MRM ion-pair library extraction from mzML/WIFF with RT alignment, standard curves and isomer ion-pair handling; GC-MS scan/SIM ion extraction with vendor CDF and mzML raw readers (Agilent, Bruker, Finnigan, Shimadzu); plus PK (pharmacokinetics) analysis and TPA content reporting.</ReleaseNotes>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Version>1.0.9767.32135</Version>
    <AssemblyVersion>1.0.9767.32135</AssemblyVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

