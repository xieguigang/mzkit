<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.BioDeep.MetaDNA</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>BioNovoGene.BioDeep.MetaDNA</AssemblyName>
    <Platforms>AnyCPU;ARM32;x64</Platforms>
    <Configurations>Debug;Release;Rsharp_app_release;mzkit_win32;nuget_release</Configurations>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageIcon>Flask.png</PackageIcon>
    <PackageIconUrl />
	  <OutputPath>../../../Rscript\Library\mzkit_app\assembly\</OutputPath>
	  <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
	  <Title>MetaDNA Network-based Metabolite Annotation</Title>
	  <Description>Implementation of the MetaDNA algorithm for untargeted metabolomics: network-based recursive metabolite annotation for unknown HRMS features, combining MS1 precursor search, DIA MS/MS spectral matching against KEGG compound libraries, iterative KEGG reaction network inference and m/z-set enrichment analysis (GSEA-style).</Description>
	  <PackageTags>mzkit, metadna, metabolite-annotation, kegg, network-inference, unknown-metabolites, gsea-enrichment, diasearch</PackageTags>
	  <ReleaseNotes>MetaDNA algorithm implementation for untargeted metabolomics: annotates unknown HRMS features by combining MS1 precursor search (adducts and ppm tolerance), DIA MS/MS spectral matching against KEGG compound libraries, and iterative network inference where annotated seed metabolites propagate annotations to unknowns via KEGG reaction network alignment; also provides MS joint-connection m/z-set enrichment analysis (GSEA-style) over KEGG pathway and compound clusters.</ReleaseNotes>
	  <Company>ZhuLab</Company>
	  <Authors>gg.xie@bionovogene.com</Authors>
	  <Product>MZKit</Product>
	  <Copyright>Copyright © BioNovoGene 2023</Copyright>
	  <PackageProjectUrl>https://github.com/xieguigang/mzkit</PackageProjectUrl>
	  <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Version>1.0.9767.32135</Version>
    <AssemblyVersion>1.0.9767.32135</AssemblyVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

