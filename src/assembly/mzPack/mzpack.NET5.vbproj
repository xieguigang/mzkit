<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.Analytical.MassSpectrometry.Assembly</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>BioNovoGene.Analytical.MassSpectrometry.Assembly.mzPack</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;PlantMAT;mzkit;Rsharp_app_release;MEMI-Desktop;nuget_release</Configurations>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>xieguigang</Authors>
    <Company>BioNovoGene</Company>
    <Product>BioDeep</Product>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>http://mzkit.org</PackageProjectUrl>
    <PackageIcon>Flask.png</PackageIcon>
    <PackageIconUrl />
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <Title>mzPack Binary Data Format</Title>
    <Description>The mzPack binary file format library of the mzkit toolbox: a unified packed storage for MS1/MS2 scans, chromatograms, metadata and thumbnails, with v1.0 and streaming v2.0 readers and writers, conversion from mzML/mzXML/CDF and GCMS raw data, and MZWork (.mzWork) archive save/parse.</Description>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mzkit, mzpack, binary-format, streaming, mzml-converter, gcms, archive, chromatogram</PackageTags>
    <ReleaseNotes>mzPack binary data format library: reads and writes the unified mzPack packed storage for MS1/MS2 scans, chromatograms, metadata and thumbnails; supports both the classic v1.0 format and the streaming v2.0 mzStream writer; converts mzML, mzXML, netCDF and GCMS raw data into mzPack; and provides MZWork (.mzWork) archive save and parse support.</ReleaseNotes>
    <AssemblyVersion>2.33.9768.41283</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <Version>2.33.9768.41283</Version>
    <Copyright>gg.xie@bionovogene.com</Copyright>
    <RepositoryUrl>https://github.com/xieguigang/mzkit</RepositoryUrl>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DocumentationFile>BioNovoGene.Analytical.MassSpectrometry.Assembly.mzPack.xml</DocumentationFile>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineConstants>netcore5=1</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DocumentationFile>BioNovoGene.Analytical.MassSpectrometry.Assembly.mzPack.xml</DocumentationFile>
