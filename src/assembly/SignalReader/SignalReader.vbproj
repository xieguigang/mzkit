<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.Analytical.MassSpectrometry.SignalReader</RootNamespace>
	  <AssemblyName>BioNovoGene.Analytical.MassSpectrometry.SignalReader</AssemblyName>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
	  <Platforms>AnyCPU;x64</Platforms>
	  <Configurations>Debug;Release;LipidSearch;PlantMAT;mzkit;NPSearch;Rsharp_app_release;mzkit_win32;MEMI-Desktop;nuget_release</Configurations>
	  <Authors>xieguigang &lt;I@xieguigang.me&gt;</Authors>
	  <Company>BioNovoGene</Company>
	  <Product>BioDeep</Product>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <PackageProjectUrl>http://mzkit.org</PackageProjectUrl>
	  <PackageIcon>Flask.png</PackageIcon>
	  <PackageIconUrl />
	  <Title>Chromatogram and UV/Raman Signal Reader</Title>
	  <Description>Signal reader for non-MS channels in mzML/mzXML data: extracts TIC/BPC and ion chromatograms, UV spectroscopy scans (electromagnetic radiation spectra and time signals) and Raman spectroscopy signals from base64-encoded mzML nodes.</Description>
	  <PackageTags>mzkit, chromatogram, tic, bpc, uv-spectroscopy, raman, signal-reader, mzml</PackageTags>
	  <ReleaseNotes>Signal reader library for mzkit: extracts TIC/BPC and targeted ion chromatograms from mzML and mzXML data; reads UV spectroscopy scans including electromagnetic radiation spectra and time-domain signals; and parses Raman spectroscopy signals stored in base64-encoded mzML markup nodes.</ReleaseNotes>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	  <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Version>1.0.9767.32135</Version>
    <AssemblyVersion>1.0.9767.32135</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../Rscript/Library/mzkit_app/assembly/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\.pkg\Flask.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Composition" Version="10.0.12" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Data\BinaryData\BinaryData\binarydata-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\Math\Math\Math.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Data_science\Mathematica\SignalProcessing\SignalProcessing\signalprocessing-netcore5.vbproj" />
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\mzmath\mz_deco\deconv.NET5.vbproj" />
    <ProjectReference Include="..\assembly\assembly-netcore5.vbproj" />
  </ItemGroup>

</Project>
