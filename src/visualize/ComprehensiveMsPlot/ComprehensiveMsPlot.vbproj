<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.Analytical.MassSpectrometry.Visualization</RootNamespace>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <AssemblyName>BioNovoGene.Analytical.MassSpectrometry.ComprehensiveMsPlot</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;mzkit;Rsharp_app_release;MEMI-Desktop;nuget_release</Configurations>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <Title>GCxGC Data Plotting</Title>
    <Description>GCxGC (two-dimensional comprehensive gas chromatography) plotting library: renders TIC data as 2D heat maps, 3D peak plots and GCxGC heat maps with signal cutting and filling of pixel matrix heat maps, built on the shared Plot graphics framework.</Description>
    <PackageTags>mzkit, gcxgc, mass-spectrometry, heatmap, tic, 2d-plot, visualization, metabolomics</PackageTags>
    <ReleaseNotes>GCxGC plotting library for mzkit: renders two-dimensional GCxGC total ion current data as 2D heat maps, 3D peak plots and GCxGC heat maps; supports signal cutting and filling of pixel matrix heat maps; built on the shared Plot graphics framework.</ReleaseNotes>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>Flask.png</PackageIcon>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Version>1.0.9767.32135</Version>
    <AssemblyVersion>1.0.9767.32135</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='nuget_release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../Rscript/Library/mzkit_app/assembly/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\.pkg\Flask.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\gr\Microsoft.VisualBasic.Imaging\imaging.NET5.vbproj" />
    <ProjectReference Include="..\..\..\..\GCModeller\src\runtime\sciBASIC#\Microsoft.VisualBasic.Core\src\Core.vbproj" />
    <ProjectReference Include="..\..\mzmath\GCxGC\GCxGC.vbproj" />
    <ProjectReference Include="..\MsImaging\MsImaging.NET5.vbproj" />
    <ProjectReference Include="..\TissueMorphology\TissueMorphology.vbproj" />
  </ItemGroup>

</Project>
