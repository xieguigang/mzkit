<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BioNovoGene.BioDeep.Chemistry.MetaLib</RootNamespace>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <AssemblyName>BioNovoGene.BioDeep.Chemistry.XrefEngine</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;LipidSearch;mzkit;NPSearch;Rsharp_app_release;mzkit_win32;MEMI-Desktop;nuget_release</Configurations>
    <PackageIcon>Flask.png</PackageIcon>
    <PackageIconUrl />
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AutoGenerateBindingRedirects>True</AutoGenerateBindingRedirects>
    <Title>Annotation Xref Engine and Workspace</Title>
    <Description>Metabolite annotation cross-reference engine: manages a local HDSPack binary repository of annotation records with offset-indexed metadata and database xref lookup (MessagePack serialization), plus ChemOnt/ClassyFire chemical classification support for filling compound ontology classes in annotation workspaces.</Description>
    <PackageTags>mzkit, cross-reference, xref, annotation-engine, classyfire, chemont, compound-classification, hdspack</PackageTags>
    <ReleaseNotes>Annotation cross-reference engine for mzkit: manages local HDSPack binary repositories of metabolite annotation records with offset-indexed lookup of metadata and database xrefs using MessagePack serialization; supports ChemOnt/ClassyFire chemical classification for filling compound ontology classes across annotation workspace peak tables, XIC caches and library hits.</ReleaseNotes>
    <PackageOutputPath>..\..\..\.nuget</PackageOutputPath>
    <Version>1.0.9768.41283</Version>
    <AssemblyVersion>1.0.9768.41283</AssemblyVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

